{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-copy.schema.json",
  "title": "PublicCopy",
  "description": "Public projection only. Internal generation, audit, review, and trace fields are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "actionLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
